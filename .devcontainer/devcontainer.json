{
  "name": "ghostun",
  // Matches the release builder (Rust 1.99, Debian trixie); clippy and rustfmt are preinstalled.
  "image": "mcr.microsoft.com/devcontainers/rust:1-trixie",
  "features": {
    // Runs the disposable e2e containers from tests/README.md. Moby has no trixie packages.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  // Apple container (socktainer) defaults to 1 GiB, too little for rust-analyzer plus LTO builds.
  "runArgs": ["--memory=8g"],
  "containerEnv": {
    "RUST_BACKTRACE": "1"
  },
  // CI also lints the musl release targets.
  "postCreateCommand": "rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl",
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.allTargets": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck",
        "ms-python.python"
      ]
    }
  }
}
